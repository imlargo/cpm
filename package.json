{
  "name": "{{PACKAGE_NAME}}",
  "type": "module",
  "version": "0.0.0",
  "description": "{{PACKAGE_DESCRIPTION}}",
  "license": "MIT",
  "author": "{{AUTHOR_NAME}}",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{GITHUB_OWNER}}/{{REPO_NAME}}.git"
  },
  "homepage": "https://github.com/{{GITHUB_OWNER}}/{{REPO_NAME}}#readme",
  "bugs": {
    "url": "https://github.com/{{GITHUB_OWNER}}/{{REPO_NAME}}/issues"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "pack:check": "publint && attw --pack --profile esm-only",
    "prepublishOnly": "pnpm build && pnpm pack:check",
    "prepare": "husky || true",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
