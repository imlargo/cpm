{
  "name": "@kora/critical-path-method",
  "type": "module",
  "version": "0.0.0",
  "description": "Critical Path Method engine in TypeScript. Pure functions, zero runtime dependencies, injectable working calendar.",
  "license": "MIT",
  "author": "imlargo",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlargo/cpm.git"
  },
  "homepage": "https://github.com/imlargo/cpm#readme",
  "bugs": {
    "url": "https://github.com/imlargo/cpm/issues"
  },
  "keywords": [
    "cpm",
    "critical-path",
    "critical-path-method",
    "scheduling",
    "project-management",
    "gantt",
    "pert",
    "float",
    "slack",
    "working-calendar",
    "dependency-graph",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "pack:check": "publint && attw --pack --profile esm-only",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "prepublishOnly": "pnpm build && pnpm pack:check",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  }
}
